rules_version = '2';

/* Birthday Celebration — Firestore security rules.  NO SIGN-IN.
 *
 * Nobody is ever asked to sign in — not the team, not the organiser.
 * Everyone who opens the page is signed in silently and anonymously, purely
 * so Firestore has someone to talk to; it carries no identity and grants no
 * special standing.
 *
 * WHAT THIS MEANS, PLAINLY: with no sign-in there is nothing that tells the
 * organiser apart from anyone else, so anyone who has the URL can read and
 * change everything here — the orders, the wishes, the roster, the menu, the
 * budget and the expense claim. The link IS the password. Share it with the
 * department, not on anything public.
 *
 * WHAT IT STILL STOPS: the wider internet without the link, and anything
 * outside the collections named below — the catch-all at the bottom closes
 * the rest of the database.
 *
 * TO LOCK IT DOWN LATER: set authProvider back to "email" in app/config.js
 * and restore the organiser() checks (git history has the earlier version).
 * The organiser then signs in by a one-click emailed link, and the settings,
 * roster and claim go back to being theirs alone.
 *
 * Deploy:  Firestore Database -> Rules -> paste -> Publish
 * Requires: Authentication -> Sign-in method -> Anonymous  ENABLED
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone with the page open. Everyone is a silent anonymous visitor.
    function visitor() {
      return request.auth != null;
    }

    // ---- menu, budget, brands, cost centres ---------------------------
    match /config/{doc} {
      allow read, write: if visitor();
    }

    // ---- who has a birthday when --------------------------------------
    match /roster/{id} {
      allow read, write: if visitor();
    }

    // ---- each month's celebration -------------------------------------
    // The date, venue, vendor, delivery fee and spend.
    match /events/{month} {
      allow read, write: if visitor();

      // Orders — one document per person.
      match /rsvps/{id} {
        allow read, write: if visitor();
      }

      // Wishes on the wall.
      match /wishes/{id} {
        allow read, write: if visitor();
      }
    }

    // ---- the expense claim --------------------------------------------
    // Receipt figures and the Yeeflow fields. No money moves from here, but
    // it is the most sensitive thing on the page — see the note at the top.
    match /claims/{month} {
      allow read, write: if visitor();
    }

    // ---- display names -------------------------------------------------
    match /profiles/{uid} {
      allow read, write: if visitor();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
