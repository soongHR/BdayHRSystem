rules_version = '2';

/* Birthday Celebration — Firestore security rules.  OPEN MODE.
 *
 * Nobody is asked to sign in. Everyone who opens the page is signed in
 * silently and anonymously, which is what makes "you may edit your own order
 * and nobody else's" enforceable. The organiser signs in properly, by the
 * small link in the corner, to reach the claim and the settings.
 *
 * WHAT THIS ACCEPTS: anyone with the URL can see the orders, the wishes and
 * the roster. That was a deliberate choice — no sign-in friction for staff.
 *
 * WHAT IT STILL STOPS: a passer-by cannot delete anyone's order, cannot edit
 * someone else's, cannot touch the menu, the roster or the budget, and cannot
 * see the expense claim at all. The worst they can do is add junk you delete.
 *
 * Deploy:  Firestore Database -> Rules -> paste -> Publish
 * Requires: Authentication -> Sign-in method -> Anonymous  ENABLED
 *           Authentication -> Sign-in method -> Email link ENABLED (organiser)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone who has the page open. Includes silent anonymous visitors.
    function visitor() {
      return request.auth != null;
    }

    // A real, named sign-in on the work domain — the person running it.
    function organiser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'wangseng@crestar.com.sg'
           ];
    }

    // ---- menu, budget, brands, cost centres ---------------------------
    match /config/{doc} {
      allow read:  if visitor();
      allow write: if organiser();
    }

    // ---- who has a birthday when --------------------------------------
    match /roster/{id} {
      allow read:  if visitor();
      allow write: if organiser();
    }

    // ---- each month's celebration -------------------------------------
    // The date, venue, vendor, delivery fee and spend. Organiser's to set.
    match /events/{month} {
      allow read:  if visitor();
      allow write: if organiser();

      // Orders. Each document is keyed on the person's own uid, so the rule
      // "it must be yours" is simply "the id must equal your uid".
      match /rsvps/{id} {
        allow read:   if visitor();
        allow create: if visitor() && id == request.auth.uid;
        allow update: if organiser() || (visitor() && id == request.auth.uid);
        allow delete: if organiser() || (visitor() && id == request.auth.uid);
      }

      // Wishes. Anyone may pin one and anyone may react to one; only the
      // author or the organiser can take one down.
      match /wishes/{id} {
        allow read:   if visitor();
        allow create: if visitor();
        allow update: if visitor();
        allow delete: if organiser()
                      || (resource.data.fromId != null
                          && resource.data.fromId == request.auth.uid);
      }
    }

    // ---- the expense claim --------------------------------------------
    // Money, receipts, the Yeeflow fields. Organiser only, both directions.
    match /claims/{month} {
      allow read, write: if organiser();
    }

    // ---- display names -------------------------------------------------
    match /profiles/{uid} {
      allow read:  if visitor();
      allow write: if visitor() && uid == request.auth.uid;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
